# =============================================================
# Road Damage Intelligence System - Environment Configuration
# =============================================================
# Copy this file to .env and modify as needed.
# DO NOT commit .env to version control.
# =============================================================

# --- Model Configuration ---
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
# Device: "cpu", "cuda", or "auto" (auto-detect)
DEVICE=auto

# --- Damage Class Mapping (JSON) ---
# Maps model output class indices to RDD2022 damage categories.
# Adjust if your trained model uses a different class order.
CLASS_MAPPING={"0": "D00", "1": "D10", "2": "D20", "3": "D40"}

# --- Damage Class Names ---
CLASS_NAMES={"D00": "Longitudinal Crack", "D10": "Transverse Crack", "D20": "Alligator Crack", "D40": "Pothole"}

# --- Database ---
DATABASE_URL=sqlite:///./data/road_damage.db

# --- Upload Limits ---
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tiff
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# --- Video Processing ---
FRAME_SKIP=1
MAX_VIDEO_FRAMES=10000

# --- Severity Thresholds (area ratio) ---
SEVERITY_LOW_THRESHOLD=0.01
SEVERITY_MEDIUM_THRESHOLD=0.05
SEVERITY_HIGH_THRESHOLD=0.15

# --- Tracker ---
TRACKER_TYPE=bytetrack

# --- Evidence ---
EVIDENCE_DIR=data/evidence
EVIDENCE_COOLDOWN_FRAMES=30

# --- Server ---
HOST=localhost
PORT=8000
DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO
